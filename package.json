{
  "name": "digital-twin-lab",
  "version": "1.0.0",
  "description": "Platform for creating and evaluating AI-powered digital twins",
  "main": "dist/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon",
    "watch-ts": "tsc -p tsconfig.frontend.json --watch",
    "dev-frontend": "concurrently \"npm run dev\" \"npm run watch-ts\"",
    "start": "node dist/server.js",
    "build": "npm run clean && npm run build-server && npm run build-client && npm run copy-static",
    "build-server": "tsc",
    "build-client": "tsc -p tsconfig.frontend.json",
    "copy-static": "mkdir -p dist/database dist/public && cp database/schema.sql dist/database/ && cp -r public/css public/img public/js public/favicon.ico public/index.html dist/public/",
    "clean": "rm -rf dist",
    "clean-js": "find public/js -name \"*.js\" -delete && find public/js -name \"*.js.map\" -delete",
    "db:migrate": "node scripts/migrate_prompts.js",
    "db:reset": "node scripts/reset.js",
    "db:init": "node scripts/init_db.js",
    "prepare": "husky install .husky",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,css}": ["prettier --write"],
    "src/server/**/*.ts": [
      "tsc --noEmit"
    ],
    "src/client/ts/**/*.ts": [
      "tsc -p tsconfig.frontend.json --noEmit"
    ]
  },
  "keywords": [
    "digital twin",
    "AI",
    "machine learning",
    "personalization",
    "experimentation",
    "comparison"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@types/helmet": "^0.0.48",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.0.0-rc.12",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.0",
    "helmet": "^5.1.1",
    "morgan": "^1.10.0",
    "openai": "^4.24.1",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-filename": "^1.6.3",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^5.0.2",
    "@types/cheerio": "^0.22.35",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/express-fileupload": "^1.5.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "concurrently": "^9.1.2",
    "eslint": "^8.49.0",
    "eslint-import-resolver-typescript": "^3.5.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.1",
    "nodemon": "^3.0.2",
    "prettier": "^2.8.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
