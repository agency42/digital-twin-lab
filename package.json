{
  "name": "digital-twin-lab",
  "version": "1.0.0",
  "description": "Platform for creating and evaluating AI-powered digital twins",
  "main": "dist/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon",
    "watch-ts": "tsc -p tsconfig.frontend.json --watch",
    "dev-frontend": "concurrently \"npm run dev\" \"npm run watch-ts\"",
    "start": "node dist/server.js",
    "build": "npm run clean && npm run build-server && npm run build-client && npm run copy-static",
    "build-server": "tsc",
    "build-client": "tsc -p tsconfig.frontend.json",
    "copy-static": "mkdir -p dist/database dist/public && cp database/schema.sql dist/database/ && cp -r public/css public/img public/js public/favicon.ico public/index.html dist/public/",
    "clean": "rm -rf dist",
    "clean-js": "find public/js -name \"*.js\" -delete && find public/js -name \"*.js.map\" -delete && find public/js -name \"*.ts\" -delete",
    "db:migrate": "node scripts/migrate.js",
    "db:reset": "node scripts/reset.js"
  },
  "keywords": [
    "digital twin",
    "AI",
    "machine learning",
    "personalization",
    "experimentation",
    "comparison"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@types/helmet": "^0.0.48",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.0.0-rc.12",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.0",
    "helmet": "^8.1.0",
    "image-size": "^1.0.2",
    "morgan": "^1.10.0",
    "openai": "^4.24.1",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^24.6.0",
    "sanitize-filename": "^1.6.3",
    "sqlite3": "^5.1.7",
    "url-parse": "^1.5.10",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^5.0.2",
    "@types/cheerio": "^0.22.35",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/express-fileupload": "^1.5.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
