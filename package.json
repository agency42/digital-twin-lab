{
  "name": "digital-twin-lab",
  "version": "1.0.0",
  "description": "Platform for creating and evaluating AI-powered digital twins",
  "main": "dist/src/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon",
    "start": "node dist/server.js",
    "build": "npm run clean && tsc && mkdir -p dist/database && cp database/schema.sql dist/database/ && mkdir -p dist/public/js && mkdir -p dist/public/js/modules && tsc -p tsconfig.frontend.json && cp public/js/*.js* dist/public/js/ && cp public/js/modules/*.js* dist/public/js/modules/ && cp -r public/css public/img public/favicon.ico public/index.html dist/public/",
    "clean": "rm -rf dist",
    "cleanup": "chmod +x ./cleanup.sh && ./cleanup.sh"
  },
  "keywords": [
    "digital twin",
    "AI",
    "machine learning",
    "personalization",
    "experimentation",
    "comparison",
    "raw dogging vs. abstraction"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@types/helmet": "^0.0.48",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.0.0-rc.12",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.0",
    "helmet": "^8.1.0",
    "image-size": "^1.0.2",
    "morgan": "^1.10.0",
    "openai": "^4.24.1",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^24.6.0",
    "sanitize-filename": "^1.6.3",
    "sqlite3": "^5.1.7",
    "url-parse": "^1.5.10",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^5.0.2",
    "@types/cheerio": "^0.22.35",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/express-fileupload": "^1.5.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
