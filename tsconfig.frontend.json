{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "public/js",
    "rootDir": "public/js",
    "sourceMap": true
  },
  "include": ["public/js/**/*.ts"],
  "exclude": ["node_modules", "dist"]
} 